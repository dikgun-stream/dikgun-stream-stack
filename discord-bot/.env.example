# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app ->
# Bot -> Reset Token. Treat it like a password; anyone with it controls the bot.
DISCORD_TOKEN=

# Your server id. Right-click the server icon with Developer Mode on -> Copy
# Server ID. Setting this makes slash commands appear instantly; leaving it
# blank syncs globally, which can take up to an hour.
DISCORD_GUILD_ID=

# Where the overlay/dashboard server listens. Default is correct for same-machine.
OVERLAY_BASE=http://127.0.0.1:7475
