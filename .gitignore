# Secrets and machine-specific state -- never commit these.
# Live config holds your channel and generated chat state.
overlay-server/config.json

# OBS / plugin backups routinely contain stream keys in plain text.
backend-backup/
*.bak
*.pre-drop.json
*.pre-fix.json
*.pre-scene.json

# Python
__pycache__/
*.pyc
.venv/

# Debug captures / screenshots of the real desktop
*.jpg
launcher-screen.png
dark-region.png
probe-*.png
shot-*.png

# Local machine state
*.log
state.json

# ffprobe duration cache (rebuilt on demand)
overlay-server/clips_cache.json

# Derived audio-scan index (regenerate with laughter_scan.py)
overlay-server/laughter_index.json
overlay-server/laughter_scan.log
overlay-server/kill_index.json
overlay-server/marker_index.json
overlay-server/.*.lock

# Brand assets are deliverables, not debug captures. The *.jpg rule above is
# for screenshots of the real desktop; these are commissioned artwork.
!brand/**/*.jpg

# Discord bot token - never commit
.env
discord-bot/.env
discord-bot/_clipexcerpt.mp4
discord-bot/_clipframe.jpg

# Machine-state backups - these contain the scene collection and config and are
# meant to live off this machine, not in the repo.
dikgun-backup*/

# generated by promo/blender_letters.py - re-render rather than commit
promo/stingers/

# CC0 textures - fetch with promo/get_textures.ps1, do not commit binaries
promo/cracked_*.jpg

# generated outro frames and the encoded clip
promo/outro_frames/
promo/outro.mp4

# generated from the brand avatar by promo/make_mark.py
promo/mark_rgba.png
promo/mark_left.png
promo/mark_right.png
